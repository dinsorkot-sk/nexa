PORT=3001
# Folder holding one PGlite database per tenant (relative to apps/api)
NEXA_DATA_DIR=./data
# Tenants this server may open/create (comma separated); each gets the modules in NEXA_MODULES
NEXA_TENANTS=dev
NEXA_MODULES=base
# DEVELOPMENT ONLY: trust X-Nexa-Tenant / X-Nexa-Uid headers as authentication. Never enable in production.
NEXA_DEV_AUTH=1
