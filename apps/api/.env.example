PORT=3001
# Database backend: pglite (default, embedded, one data dir per tenant) or postgres (one database per tenant)
NEXA_DB=pglite
# Required when NEXA_DB=postgres: admin connection string; the role needs CREATEDB. Tenant databases are
# named nexa_<tenant> and created on first use. NEXA_DATA_DIR is ignored with postgres.
# NEXA_PG_URL=postgres://nexa:secret@localhost:5432/postgres
# Folder holding one PGlite database per tenant (relative to apps/api)
NEXA_DATA_DIR=./data
# Tenants this server may open/create (comma separated); each gets the modules in NEXA_MODULES
NEXA_TENANTS=dev
NEXA_MODULES=base
# For the demo, use NEXA_MODULES=base,contacts,sales_lite
# Add report to enable reports; installs the mail module dependency. PDF also requires Playwright Chromium.
# Local development only. Production always uses bearer credentials.
NEXA_DEV_AUTH=0
# Comma-separated document models eligible for read-only Portal links (empty disables sharing).
NEXA_PORTAL_MODELS=
# Optional outbound SMTP relay. Set tenant, host and sender together. Port 465 uses implicit TLS.
# NEXA_SMTP_TENANT=dev
# NEXA_SMTP_HOST=smtp.example.com
# NEXA_SMTP_PORT=587
# NEXA_SMTP_FROM=nexa@example.com
# NEXA_SMTP_USER=
# NEXA_SMTP_PASSWORD=
