{
  "root": true,
  "env": {
    "es2022": true,
    "node": true,
    "browser": true
  },
  "extends": ["eslint:recommended", "plugin:vue/vue3-recommended", "@typescript-eslint/recommended"],
  "parser": "vue-eslint-parser",
  "parserOptions": {
    "parser": "@typescript-eslint/parser",
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "vue"],
  "ignorePatterns": ["**/.nuxt/**", "**/.output/**", "**/dist/**", "node_modules/**"]
}
