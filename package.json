{
  "name": "nexa",
  "version": "0.0.0",
  "private": true,
  "description": "Nexa monorepo - web, server, desktop, mobile",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --passWithNoTests",
    "tokens": "tsx scripts/figcraft-tokens.ts",
    "tokens:check": "tsx scripts/figcraft-tokens.ts --check",
    "clean": "turbo run clean",
    "patch": "patch-package",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "patch-package": "^8.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  }
}
