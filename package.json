{
  "name": "nexa-template",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @nexa/api db:generate",
    "db:migrate": "pnpm --filter @nexa/api db:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "turbo": "^2.5.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.6"
  }
}
