{
  "name": "nexa",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --filter=@nexa/server",
    "dev:api": "turbo run dev --filter=@nexa/server",
    "db:migrate": "pnpm --filter @nexa/db db:migrate",
    "db:seed": "pnpm --filter @nexa/db db:seed",
    "db:check": "pnpm --filter @nexa/db db:check",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "clean": "turbo run clean",
    "dev:worker": "turbo run dev:worker --filter=@nexa/server"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-plugin-vue": "^9.32.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "vue-eslint-parser": "^9.4.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "histoire": "patches/histoire.patch"
    }
  }
}
